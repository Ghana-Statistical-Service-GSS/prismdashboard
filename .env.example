PRISM_BACKEND_URL=http://localhost:6001
# Production: PRISM_BACKEND_URL=https://api.prism.statsghana.gov.gh
# Optional in Docker: use the backend container/service address to avoid
# routing server-to-server calls through the public TLS reverse proxy.
# PRISM_BACKEND_INTERNAL_URL=http://prism-backend:6001
# PPI firm web form (/f/...): the same value as PPI_FIRM_PROXY_SECRET on the
# backend (at least 16 characters), and the public base of the firm links.
# PPI_FIRM_PROXY_SECRET=
# PPI_FIRM_PUBLIC_URL=https://prism.statsghana.gov.gh
